<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout style="@style/HorizontalSeparator"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/a4_big_down"
            android:text="&lt;&lt;"
            style="@style/StepButton"/>
        <Button
            android:id="@+id/a4_small_down"
            android:text="&lt;"
            style="@style/StepButton"/>
        <EditText
            android:id="@+id/a4_textHz"
            style="@style/StepText"/>
        <Button
            android:id="@+id/a4_small_up"
            android:text="&gt;"
            style="@style/StepButton"/>
        <Button
            android:id="@+id/a4_big_up"
            android:text="&gt;&gt;"
            style="@style/StepButton"/>
    </LinearLayout>
    <LinearLayout style="@style/HorizontalSeparator"/>
    <LinearLayout
        android:orientation="horizontal"
        android:background="#808080"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <Button
            android:id="@+id/a4_buttonOk"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="2dp"
            android:text="Ok"
            android:layout_weight="1"/>
        <Button
            android:id="@+id/a4_buttonReset"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="2dp"
            android:text="Reset"
            android:layout_weight="1"/>
        <Button
            android:id="@+id/a4_buttonCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="2dp"
            android:text="Cancel"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
