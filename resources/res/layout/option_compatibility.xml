<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout style="@style/HorizontalSeparator"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:gravity="center_vertical"
            android:paddingLeft="12dp"
            android:layout_width="0px"
            android:layout_height="match_parent"
            android:text="Spectrogram"
            android:layout_weight="1"/>
        <Spinner
            android:id="@+id/compatibility_spinnerSpectrogram"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:gravity="center_vertical"
            android:paddingLeft="12dp"
            android:layout_width="0px"
            android:layout_height="match_parent"
            android:text="Audio Setup"
            android:layout_weight="1"/>
        <Spinner
            android:id="@+id/compatibility_spinnerAudioSetup"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:gravity="center_vertical"
            android:paddingLeft="12dp"
            android:layout_width="0px"
            android:layout_height="match_parent"
            android:text="Audio Analysis"
            android:layout_weight="1"/>
        <Spinner
            android:id="@+id/compatibility_spinnerAudioAnalysis"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout style="@style/HorizontalSeparator"/>
    <LinearLayout
        android:orientation="horizontal"
        android:background="#808080"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <Button
            android:id="@+id/compatibility_buttonOk"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="2dp"
            android:text="Ok"
            android:layout_weight="1"/>
        <Button
            android:id="@+id/compatibility_buttonCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="2dp"
            android:text="Cancel"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
