<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="29"
    android:versionName="1.0.22"
    package="com.symbolic.pitchlab">
    <supports-screens
        android:anyDensity="true"
        android:smallScreens="true"
        android:normalScreens="true"
        android:largeScreens="true"/>
    <uses-sdk
        android:minSdkVersion="9"
        android:targetSdkVersion="13"/>
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true"/>
    <uses-feature
        android:glEsVersion="0x10000"
        android:required="true"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="true">
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version"/>
        <activity
            android:theme="@android:style/Theme.NoTitleBar"
            android:label="@string/crashlogs_title"
            android:name="com.symbolic.pitchlab.ActivityCrashlogs"
            android:configChanges="screenSize|orientation|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity
            android:theme="@android:style/Theme.NoTitleBar"
            android:label="@string/welcome_title"
            android:name="com.symbolic.pitchlab.ActivityWelcome"
            android:configChanges="screenSize|orientation|keyboardHidden"/>
        <activity
            android:theme="@android:style/Theme.NoTitleBar"
            android:label="@string/main_title"
            android:name="com.symbolic.pitchlab.ActivityVisualiser"
            android:configChanges="screenSize|orientation|keyboardHidden"/>
        <activity
            android:label="@string/options_title"
            android:name="com.symbolic.pitchlab.ActivityOptions"
            android:configChanges="screenSize|orientation|keyboardHidden"/>
        <activity
            android:name="com.google.android.gms.ads.AdActivity"
            android:configChanges="smallestScreenSize|screenSize|uiMode|screenLayout|orientation|keyboardHidden|keyboard"/>
    </application>
</manifest>
